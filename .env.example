# Apify: https://console.apify.com/settings/integrations (free plan includes ~$5/month credit)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
# Firecrawl: https://www.firecrawl.dev/app/api-keys (free tier, used only as a fallback)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxx
# Anthropic: optional. Only used by `extract --use-llm`; the default extractor is rule-based and free.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
